{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shouldipostnow.com" }],
      "destination": "https://www.shouldipostnow.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "should-i-post.vercel.app" }],
      "destination": "https://www.shouldipostnow.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(styles|logic|app|translations|i18n)\\.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(favicon-48|favicon-96|favicon|logo-512|logo-192|og-image|shouldipostlogo)\\.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/favicon\\.(ico|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/logo\\.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/robots\\.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
